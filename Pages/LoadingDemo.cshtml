@page
@model HCAEFLoadingDemo.Pages.LoadingDemoModel

<h1>EF Core Loading Strategies Demo - HCA Healthcare</h1>

<form method="get">
    <label>Nurse ID (1-3):</label>
    <input type="number" name="nurseId" min="1" max="3" value="1" />
    <label>Strategy:</label>
    <select name="strategy">
        <option value="lazy">Lazy Loading</option>
        <option value="eager">Eager Loading</option>
        <option value="explicit">Explicit Loading</option>
    </select>
    <button type="submit" class="btn btn-primary">Load Nurse & Shifts</button>
</form>

@if (Model.Nurse != null)
{
    <h3>@Model.LoadingStrategy: Nurse @Model.Nurse.FirstName @Model.Nurse.LastName (@Model.Nurse.Department)</h3>
    <p>Hired: @Model.Nurse.HireDate.ToShortDateString()</p>
    <h4>Shifts (@Model.Nurse.Shifts.Count):</h4>
    <table class="table">
        <tr><th>Shift ID</th><th>Start</th><th>End</th><th>Duration</th><th>Notes</th></tr>
        @foreach (var shift in Model.Nurse.Shifts)
        {
            <tr>
                <td>@shift.ShiftID</td>
                <td>@shift.StartTime.ToString("g")</td>
                <td>@shift.EndTime.ToString("g")</td>
                <td>@shift.DurationHours</td>
                <td>@shift.Notes</td>
            </tr>
        }
    </table>
    <h4>Queries Executed (Wow Factor!):</h4>
    <ul>
        @foreach (var query in Model.QueriesExecuted)
        {
            <li>@query</li>
        }
    </ul>
}
else
{
    <p>Nurse not found. Try ID 1-3.</p>
}

